# ================= ИТ-портал =================
# Портал для ИТ-отдела (главная, инвентарь, документы, задачи, обработка заявок)
PORT=3000
# Сайт заявок для всех сотрудников предприятия (0 — не запускать)
HELPDESK_PORT=3100
NODE_ENV=production

# Случайные длинные строки (например: openssl rand -hex 32).
# ВАЖНО: при переходе с ИТ-инвентаря перенесите сюда ОБА значения из его старого .env —
# иначе сохранённые пароли устройств не расшифруются.
SESSION_SECRET=замените_на_случайную_строку
APP_SECRET_KEY=замените_на_другую_случайную_строку

# true — если сайт работает по HTTPS (включает secure-cookie и HSTS)
COOKIE_SECURE=false
# 1 — если сайт стоит за обратным прокси (nginx)
# (обязательно, если перед порталом стоит nginx — см. README)
# TRUST_PROXY=1

# ---- PostgreSQL (та же база, что у ИТ-инвентаря) ----
PGHOST=localhost
PGPORT=5432
PGUSER=itdb
PGPASSWORD=itdb_password
PGDATABASE=itdb
# или одной строкой:
# DATABASE_URL=postgres://itdb:itdb_password@localhost:5432/itdb

# ---- Первый администратор (создаётся, только если в базе нет ни одного) ----
ADMIN_USERNAME=admin
ADMIN_PASSWORD=admin12345

# ---- Helpdesk ----
# Адреса, которые увидят пользователи в ссылках (в письмах и на главной странице).
# Если не заданы — берётся имя компьютера из адресной строки браузера.
# За nginx укажите его адреса, например http://it.company.local и http://helpdesk.company.local
# PORTAL_URL=http://it-server:3000
# HELPDESK_URL=http://it-server:3100
# Домены внутренней почты для регистрации (через запятую). Можно поменять позже в «Заявки → Настройки».
HELPDESK_EMAIL_DOMAINS=company.local

# ---- Почта (необязательно) ----
# Если указан SMTP-сервер, сотрудники подтверждают регистрацию кодом из письма,
# могут сами восстановить пароль и получают уведомления о ходе заявки.
# Без SMTP регистрация работает без подтверждения по почте
# (при желании включите ручное подтверждение регистраций в «Заявки → Настройки»).
# SMTP_HOST=mail.company.local
# SMTP_PORT=25
# SMTP_SECURE=false
# SMTP_USER=helpdesk@company.local
# SMTP_PASS=
# MAIL_FROM=ИТ-отдел <helpdesk@company.local>
# SMTP_TLS_REJECT_UNAUTHORIZED=false
